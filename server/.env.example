# ===== Server =====
PORT=5000

# ===== MySQL (XAMPP default: root with no password) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tuana_perfume

# ===== Dashboard login =====
# Users are saved in the "users" table (add them from the dashboard)
JWT_SECRET=write-any-long-random-text-here

# ===== Shop =====
CURRENCY=EGP

# ===== Payment =====
# demo   = test the checkout without any gateway (no real money)
# stripe = real card payments with Stripe
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
