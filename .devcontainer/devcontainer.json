{
    "name": "TUANA Perfume Store",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

    // 1) Runs once when the Codespace is created: installs everything
    "postCreateCommand": "bash .devcontainer/setup.sh",

    // 2) Runs every time the Codespace starts: starts MySQL + the website
    "postStartCommand": "bash .devcontainer/start.sh",

    "forwardPorts": [5000],
    "portsAttributes": {
        "5000": { "label": "TUANA Website", "onAutoForward": "openBrowser" }
    }
}
